{
  "name": "umbral",
  "version": "1.0.0",
  "private": true,
  "description": "Umbral: sitio promocional y PWA demo de un smartwatch sensorial para personas autistas y neurodivergentes.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build:css": "tailwindcss -i src/styles.css -o assets/css/styles.css --minify",
    "build:faces": "node scripts/render-faces.mjs",
    "build:icons": "node scripts/gen-icons.mjs",
    "build": "npm run build:faces && npm run build:css",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.11",
    "tailwindcss": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
